{
  "name": "@enderliquid/tavily-cli",
  "version": "0.1.0",
  "description": "面向 Agent 的 Tavily CLI，实现了多账号额度池",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tavily-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20.1.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "check": "biome check && tsc --noEmit && vitest run",
    "prepare": "tsup"
  },
  "keywords": [
    "tavily",
    "web-search",
    "cli"
  ],
  "dependencies": {
    "@tavily/core": "^1.1.0",
    "commander": "^15.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
